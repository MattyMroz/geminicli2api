# ============================================================
#  geminicli2api — .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# ── Virtual environment ────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── uv package manager ────────────────────────────────────
uv.lock

# ── Environment / secrets ─────────────────────────────────
.env
.env.*
!.env.example

# ── OAuth accounts (SENSITIVE — never commit) ─────────────
accounts/*.json
!accounts/.gitkeep
oauth_creds.json

# ── Workspace (user data) ─────────────────────────────────
# Ignore all workspace content except the README and the .gitkeep files
# that keep the fixed directories alive across a fresh clone.
workspace/*
!workspace/README.md
!workspace/input/
!workspace/output/
!workspace/output_txt/
!workspace/temp/
workspace/input/*
workspace/output/*
workspace/output_txt/*
workspace/temp/*
!workspace/input/.gitkeep
!workspace/output/.gitkeep
!workspace/output_txt/.gitkeep
!workspace/temp/.gitkeep

# ── Agent tooling (synced from the agents repo, not project code) ──
# Generated by `python <agents>/sync.py --all`; the agents repo is the
# source of truth, so nothing here is committed.
.claude/
.agents/
.codex/

# ── IDE / editor ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── GitHub Copilot customizations (personal) ──────────────
.github/
.DS_Store
Thumbs.db
desktop.ini

# ── Test / dev artifacts ──────────────────────────────────
test_all_models.py
test_concurrency.py
*.log
htmlcov/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── OS files ──────────────────────────────────────────────
*.tmp
*.bak
*.orig
