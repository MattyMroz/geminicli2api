# ============================================================
#  geminicli2api — .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# ── Virtual environment ────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── uv package manager ────────────────────────────────────
uv.lock

# ── Environment / secrets ─────────────────────────────────
.env
.env.*
!.env.example

# ── OAuth accounts (SENSITIVE — never commit) ─────────────
accounts/*.json
!accounts/.gitkeep
oauth_creds.json

# ── Workspace (user data) ─────────────────────────────────
# Ignorujemy CAŁY workspace/ — trzymamy tylko README z opisem metody.
workspace/*
!workspace/README.md

# ── IDE / editor ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── GitHub Copilot customizations (personal) ──────────────
.github/
.DS_Store
Thumbs.db
desktop.ini

# ── Test / dev artifacts ──────────────────────────────────
test_all_models.py
test_concurrency.py
*.log
htmlcov/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── OS files ──────────────────────────────────────────────
*.tmp
*.bak
*.orig
